+    assert score(pred, gold)['reward'] == expected
+
+
+@pytest.mark.parametrize('raw', ['', 'garbage', 'NEW(PRP)\nTRG("x")\nSTOP',
+                                 'NEW(PRP)\nTRG("x")\nEND',
+                                 'NEW(ZZZ)\nTRG("x")\nEND\nSTOP',
+                                 'NEW(PRP)\nTRG("x")\nARG(Wrong, "a")\nEND\nSTOP',
